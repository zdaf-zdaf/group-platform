# 构建阶段
FROM node:22-alpine as build-stage

# 设置工作目录
WORKDIR /app

# 安装全局npm版本（保持与本地一致）
RUN npm install -g npm@11.5.2 --unsafe-perm

# 复制依赖文件
COPY package*.json ./

# 安装依赖（保留本地lockfile）
RUN npm install --legacy-peer-deps

# 确保vue-cli-service已安装
RUN npm install -g @vue/cli-service

# 复制项目文件
COPY . .

# 调试：显示已安装依赖
RUN npm ls --depth=0

# Vue构建命令
RUN npm run build

# 生产阶段
FROM nginx:stable-alpine as production-stage
COPY --from=build-stage /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;", "npm", "run", "serve", "--", "--port", "80"]