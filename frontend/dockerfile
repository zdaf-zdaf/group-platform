# =========================
# 构建阶段
# =========================
FROM node:22-alpine AS build-stage

# 设置工作目录
WORKDIR /app

# 安装 pnpm 或保持 npm（这里保留 npm，降低改动风险）
RUN npm install -g npm@11.5.2 --unsafe-perm

# 只复制依赖相关文件（提高缓存利用率）
COPY package*.json ./

# 安装依赖，避免 peer deps 报错
RUN npm ci --legacy-peer-deps

# 复制项目源码
COPY . .

# 构建 Vue 应用
RUN npm run build


# =========================
# 生产阶段
# =========================
FROM nginx:stable-alpine AS production-stage

# 删除默认配置，换成自定义 nginx 配置（可选）
# COPY nginx.conf /etc/nginx/conf.d/default.conf

# 从构建阶段复制产物
COPY --from=build-stage /app/dist /usr/share/nginx/html

# 只暴露必要端口
EXPOSE 80

# 运行 Nginx
CMD ["nginx", "-g", "daemon off;"]
